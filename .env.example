# PostgreSQL connection string.
# Matches docker-compose.yml out of the box; swap for any hosted Postgres.
DATABASE_URL="postgresql://sms:sms_dev_password@localhost:5433/sms_registry?schema=public"

# Where assessment submissions are written on disk (relative to the repo root).
UPLOAD_DIR="uploads"

# Maximum accepted upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES="10485760"
